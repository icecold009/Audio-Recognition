# RapidAPI Shazam (required for Shazam matching)
RAPIDAPI_KEY=

# Supabase (required for rate limiting)
SUPABASE_URL=
SUPABASE_KEY=

# Allowed browser origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# Rate limits
DAILY_LIMIT=15
MONTHLY_LIMIT=475

# Internal API secret (protects /api/match from direct access)
INTERNAL_API_SECRET=

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_SECONDS=60

# AudD (optional)
AUDD_API_TOKEN=

# AcoustID (optional)
ACOUSTID_API_KEY=

# Full path to fpcalc if not on PATH (optional)
FP_CALC_PATH=
