# RapidAPI Shazam (required for Shazam matching)
RAPIDAPI_KEY=

# Supabase server configuration (never expose the service-role key to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_ID_HMAC_SECRET=
APP_ENV=development
PORT=5000

# Optional cross-origin API clients, comma-separated. The Flask browser UI is same-origin.
CORS_ORIGINS=

# Rate limits
DAILY_LIMIT=15
MONTHLY_LIMIT=475
COOLDOWN_SECONDS=30
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_IPS=
MEMORY_LIMITER_MAX_ENTRIES=10000
MEMORY_LIMITER_TTL_SECONDS=86400

# Internal API secret (protects /api/match from direct access)
INTERNAL_API_SECRET=

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=60

# AudD (optional)
AUDD_API_TOKEN=

# AcoustID (optional)
ACOUSTID_API_KEY=

# Full path to fpcalc if not on PATH (optional)
FP_CALC_PATH=

# Local constellation-hash fingerprint index (optional fourth backend)
LOCAL_FINGERPRINT_INDEX=
# Legacy alias for the local spectrogram-peak / constellation-hash index
FINGERPRINT_INDEX_PATH=

# Shared normalized audio contract
INTERNAL_SAMPLE_RATE=44100
MIN_AUDIO_SECONDS=1
MAX_AUDIO_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=15

# Development convenience; keep disabled outside local debugging
FLASK_DEBUG=0

# Production WSGI server and bounded request/runtime timeouts
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=45
